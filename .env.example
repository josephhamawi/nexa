# Telegram: your remote control. Create a bot with @BotFather, get your chat id
# from @userinfobot. Only this chat may command Nexa.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI provider. Nexa runs without one, planning with rules instead.
ANTHROPIC_API_KEY=

# Or any OpenAI-compatible server (OpenAI, Ollama, vLLM, LM Studio).
OPENAI_API_KEY=
OPENAI_BASE_URL=

NODE_ENV=development
LOG_LEVEL=info

# Never put passwords for third-party websites here. Nexa does not use them:
# when a site needs a login, it hands you the browser.
