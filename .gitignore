# account, logs and monitor state.
data/sessions/
data/screenshots/
data/logs/
data/state/

# Build output and installers (the .dmg is ~108 MB).
node_modules/
dist/
release/
*.dmg
*.zip
*.blockmap

# Misc
*.log
.DS_Store
coverage/
