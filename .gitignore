# Secrets. Never commit.
.env
.env.local

# Your own settings: profile, provider, folders.
config.json

# Runtime data: browser profiles with live sessions, evidence, logs, state.
data/

# Stray compiled output. tsc writing next to the source leaves these at the
# repo root, where they shadow the real modules and confuse a fresh clone.
/*.js
!eslint.config.js

# Build output and installers.
node_modules/
dist/
release/
*.dmg
*.zip
*.blockmap

# Misc
*.log
.DS_Store
coverage/

# E2E screenshots are regenerated by `npm run e2e`; the committed set under
# docs/screenshots is deliberate, so nothing here is ignored.

# Local notarization credentials.
scripts/notarize-env.sh
