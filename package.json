{
  "name": "nexa",
  "version": "1.0.0",
  "private": true,
  "description": "Nexa is your AI operations agent. Tell it what you need, and it can research, monitor websites, execute browser workflows, manage recurring tasks, analyze information, and report results.",
  "author": {
    "name": "Rami Zoohbi",
    "email": "rami.zoohbi@gmail.com"
  },
  "license": "MIT",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "dev": "npm run build && electron dist/main/main.js",
    "start": "electron dist/main/main.js",
    "agent": "tsx src/cli/agent.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "autostart": "node scripts/autostart.mjs install",
    "autostart:status": "node scripts/autostart.mjs status",
    "autostart:remove": "node scripts/autostart.mjs remove",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:telegram": "tsx src/cli/testTelegram.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && electron-builder --mac --publish never",
    "postinstall": "playwright install chromium",
    "e2e": "npm run build && tsx e2e/drive.ts",
    "screenshots": "npm run build && tsx e2e/screenshots.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.21.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "build": {
    "appId": "com.nexa.agent",
    "productName": "Nexa",
    "copyright": "Nexa. Local-first AI operations agent.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "config.example.json",
        "to": "config.json"
      }
    ],
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "C8J4Z79SX4"
      }
    },
    "dmg": {
      "title": "Nexa"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}
